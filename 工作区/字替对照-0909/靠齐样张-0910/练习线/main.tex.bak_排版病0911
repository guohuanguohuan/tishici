\tihao{1}\tieside{简单(知识点一)}下列说法正确的是\nobreak(\kongwei)
\lxopt{A．若\(| \overrightarrow{a} | = | \overrightarrow{b} |\)，则\nobreak\(\overrightarrow{a} = \overrightarrow{b}\)或\(\overrightarrow{a} = - \overrightarrow{b}\)；}
\lxopt{B．若\(\overrightarrow{a},\overrightarrow{b}\)为相反向量，则\nobreak\(\overrightarrow{a} + \overrightarrow{b} = \overrightarrow{0}\)；}
\lxopt{C．零向量是没有方向的向量；}
\lxopt{D．若\(\overrightarrow{a},\overrightarrow{b}\)是两个单位向量，则\nobreak\(\overrightarrow{a} = \overrightarrow{b}\)}

\tihao{2}\tieside{简单(知识点一)}下列说法错误的是\nobreak(\kongwei)
\lxopt{A．零向量与任意向量都平行；}
\lxopt{B．若\(|\overrightarrow{a}|=0\)，则\nobreak\(\overrightarrow{a}=\overrightarrow{0}\)；}
\lxopt{C．若\(\overrightarrow{a}=\overrightarrow{b}\)，则\nobreak\(|\overrightarrow{a}|=|\overrightarrow{b}|\)；}
\lxopt{D．若\(\overrightarrow{a}\parallel\overrightarrow{b}\)，则\nobreak\(|\overrightarrow{a}|=|\overrightarrow{b}|\)}

\tihao{3}\tieside{简单(知识点三)}有下列说法:①若\(\overrightarrow{p} = x\overrightarrow{a} + y\overrightarrow{b}\)，则\nobreak\(\overrightarrow{p}\)与\(\overrightarrow{a}\)，\(\overrightarrow{b}\)共面；②若\(\overrightarrow{p}\)与\(\overrightarrow{a}\)，\(\overrightarrow{b}\)共面，则\nobreak\(\overrightarrow{p}\)=\emph{x}\(\overrightarrow{a}\)+\emph{y}\(\overrightarrow{b}\)；③若\(\overrightarrow{MP}\)=\emph{x}\(\overrightarrow{MA}\)+\emph{y}\(\overrightarrow{MB}\)，则\emph{P}，\emph{M}，\emph{A}，\emph{B}共面；④若\emph{P}，\emph{M}，\emph{A}，\emph{B}共面，则\nobreak\(\overrightarrow{MP}\)=\emph{x}\(\overrightarrow{MA}\)+\emph{y}\(\overrightarrow{MB}\).其中正确的是\nobreak(\kongwei)
\lxopt{\makebox[\dimexpr0.5\linewidth-1em\relax][l]{A．①②；}\makebox[\dimexpr0.5\linewidth-1em\relax][l]{B．①③④；}}
\lxopt{\makebox[\dimexpr0.5\linewidth-1em\relax][l]{C．①③；}\makebox[\dimexpr0.5\linewidth-1em\relax][l]{D．②④}}


\tihao{4}\tieside{简单(知识点二)}在空间四边形\(ABCD\)中，\(E\)，\(F\)分别为\(AB\)，\(CD\)的中点，则\nobreak\(\frac{1}{2}(\overrightarrow{AD}+\overrightarrow{BC})=\)(\kongwei)
\lxopt{\makebox[\dimexpr0.25\linewidth-0.5em\relax][l]{A．\(2\overrightarrow{EF}\)；}\makebox[\dimexpr0.25\linewidth-0.5em\relax][l]{B．\(-\overrightarrow{EF}\)；}\makebox[\dimexpr0.25\linewidth-0.5em\relax][l]{C．\(\overrightarrow{FE}\)；}\makebox[\dimexpr0.25\linewidth-0.5em\relax][l]{D．\(\overrightarrow{EF}\)}}

\tihao{5}\tieside{简单(知识点二)}设\(\overrightarrow{e_1}\)，\(\overrightarrow{e_2}\)不共线，\(\overrightarrow{a}=2\overrightarrow{e_1}+\overrightarrow{e_2}\)，\(\overrightarrow{b}=4\overrightarrow{e_1}+k\overrightarrow{e_2}\)，若\(\overrightarrow{a}\parallel\overrightarrow{b}\)，则\nobreak\(k=\)(\kongwei)
\lxopt{\makebox[\dimexpr0.25\linewidth-0.5em\relax][l]{A．\(\frac{1}{2}\)；}\makebox[\dimexpr0.25\linewidth-0.5em\relax][l]{B．\(2\)；}\makebox[\dimexpr0.25\linewidth-0.5em\relax][l]{C．\(-\frac{1}{2}\)；}\makebox[\dimexpr0.25\linewidth-0.5em\relax][l]{D．\(3\)}}

\tihao{6}\tieside{中档(知识点三)}已知矩形\(ABCD\)中，\(AB = 1\)，\(BC = \sqrt{3}\)，将矩形\(ABCD\)沿对角线\(AC\)折起，使平面\(ABC\)与平面\(ACD\)垂直，则\nobreak\(|\overrightarrow{BD}| =\)(\kongwei)．
