% ================= 7a. ansblock 统一答案环境（要件①②） =================
% 用法：\begin{ansblock}[键] 答案/详解体 \end{ansblock}
%   双模：\ansblockgraytrue（默认）＝灰底盒（不可跨栏断，适合短块）；
%         \ansblockgrayfalse＝括线式（上下 hairline，可断，适合长详解）。
%   纯题版（\showansfalse）：整块吞掉不印；[键] 锚点照常发射（对号门两档可跑）。
%   内部悬挂：一档 \qpind；小问用 \anssub。体内可放 % ans:<键> 源层注释锚。
\newif\ifansblockgray
\ansblockgraytrue
\newcommand{\anskey}[1]{\typeout{M3-ANSKEY: #1}\ignorespaces}
\newsavebox{\ansblockbox}
% —— 灰底模（lrbox 收集 minipage→关闭时 colorbox 上色；宽自补偿 fboxsep，零 overfull） ——
% 撤「\colorbox…\bgroup 跨宏配平」法：xcolor \colorbox#1#{…} 定界抓参只认字面花括号，
% \bgroup 不入参数平衡→minipage 逃出着色盒（首编实证：灰底块全数失踪且零报错）。
\newcommand{\ansgrayopen}{\begingroup\setlength{\fboxsep}{2.5pt}%
  \begin{lrbox}{\ansblockbox}\begin{minipage}{\dimexpr\linewidth-5pt\relax}%
  \everypar{\hangindent\qpind\hangafter=1}\setlength{\parindent}{\qpind}}
\newcommand{\ansgrayclose}{\end{minipage}\end{lrbox}%
  \noindent\colorbox{ansbg}{\usebox{\ansblockbox}}\par\endgroup\addvspace{1.6mm}}
% —— 括线模（hairline 上下线，可跨栏） ——
\newcommand{\ansruledopen}{\par\nobreak\addvspace{2.2pt}\nobreak
  \noindent{\color{ansrule}\rule{\linewidth}{0.5pt}}\par\nointerlineskip\vskip 1.6mm\nobreak
  \begingroup\everypar{\hangindent\qpind\hangafter=1}\setlength{\parindent}{\qpind}}
\newcommand{\ansruledclose}{\par\nobreak\vskip 1.2mm
  \noindent{\color{ansrule}\rule{\linewidth}{0.5pt}}\par\endgroup\addvspace{3pt}}
% —— 纯题版吞体（收集进弃置盒，零印面） ——
\newcommand{\ansblockgobble}{\par\begingroup\setbox\z@\vbox\bgroup\ignorespaces}
\newcommand{\ansblockbegin}[1]{%
  \ifx\relax#1\relax\else\typeout{M3-ANSKEY: #1}\fi
  \ifshowans
    \par\addvspace{1.4mm minus 1.4mm}% 可断可缩：灰盒与前题不焊死（multicol vsplit 需切点）
    \ifansblockgray\ansgrayopen\else\ansruledopen\fi
  \else
    \ansblockgobble
  \fi}
\newcommand{\ansblockend}{%
  \ifshowans
    \ifansblockgray\ansgrayclose\else\ansruledclose\fi
  \else
    \egroup\endgroup
  \fi}
\newenvironment{ansblock}[1][]{\ansblockbegin{#1}}{\ansblockend}
% （定义区恒执行：\ifansgray 只在环境开启瞬间求值，双模宏必须无条件存在）
